# Copy to .env.local (or set in your hosting dashboard). All are optional
# locally; set them in production.

# Live domain, no trailing slash. Used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Google Tag Manager container ID (GTM-…). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Search Console "HTML tag" verification: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 value (optional).
BING_SITE_VERIFICATION=
